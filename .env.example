# WhatsApp Bot Configuration for SAND POINT GLOBAL
# Copy this file to .env and fill in your values if needed

# Bot Configuration
BOT_NAME=SAND POINT Bot
COMPANY_NAME=شركة ساند بوينت العالمية للمقاولات
COMPANY_LOCATION=الدمام - المنطقة الشرقية

# WhatsApp Session (auto-generated, do not modify manually)
# SESSION_DATA=

# Optional: Custom phone number for display
COMPANY_PHONE=+966 13 8XX XXXX
COMPANY_MOBILE=+966 5X XXX XXXX
COMPANY_EMAIL=info@sandpoint-global.com
COMPANY_WEBSITE=www.sandpoint-global.com

# WhatsApp Pairing Code (for phone number linking)
# Set your phone number with country code (e.g., +9665XXXXXXX, +1XXXXXXX)
# When set, the bot will use pairing code auth instead of QR code
# WA_PHONE_NUMBER=+9665XXXXXXX